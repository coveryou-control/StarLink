{
  // ===================================================================================
  // Workspace editor settings — committed on purpose.
  //
  // The repository root holds about two dozen loose files and half of them are build
  // artefacts. Almost none of them can be MOVED into folders: pnpm finds
  // `pnpm-workspace.yaml` at the root, turbo finds `turbo.json`, ESLint's flat config
  // resolution finds `eslint.config.mjs`, Playwright finds `playwright.config.ts`, and
  // thirty package tsconfigs extend `../../tsconfig.base.json`. Relocating those buys a
  // shorter listing and costs a working build.
  //
  // So the grouping happens where the problem actually is — in the explorer. Nothing
  // below moves, renames or hides a file from any tool; it changes what the tree draws.
  // ===================================================================================

  // --- Artefacts, not source -------------------------------------------------------
  // Every entry here is git-ignored and regenerated by a command. They are the bulk of
  // what makes the tree feel enormous: `node_modules` alone is tens of thousands of
  // files. `.local/` is deliberately NOT hidden — it is your own scratch (dev env,
  // service logs, screenshots) and you need to see it.
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/.turbo": true,
    "**/.next": true,
    "**/dist": true,
    "**/*.tsbuildinfo": true,
    ".playwright": true,
    "test-results": true,
    "playwright-report": true,
    ".playwright-report.json": true,
    ".vitest-report.json": true
  },

  // Search and the file watcher pay for these separately from the tree. `dist` stays
  // searchable on purpose: a boundary violation resolves to a package's BUILT entry
  // point, and being unable to grep it is how that class of bug hides.
  "search.exclude": {
    "**/node_modules": true,
    "**/.turbo": true,
    "**/.next": true,
    "pnpm-lock.yaml": true,
    "test-results": true,
    ".local/shots": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.turbo/**": true,
    "**/.next/**": true,
    "**/dist/**": true,
    "**/test-results/**": true
  },

  // --- The grouping ----------------------------------------------------------------
  // Related root files collapse under the one that owns them, so the root reads as
  // "directories, plus three entries" instead of a wall. Click the arrow to expand.
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    // Everything that configures the monorepo's build, test and lint pipeline.
    "package.json": "pnpm-lock.yaml, pnpm-workspace.yaml, turbo.json, tsconfig*.json, vitest.config.ts, vitest.workspace.ts, eslint.config.mjs, playwright.config.ts, .dependency-cruiser.cjs, .nvmrc, Dockerfile, .dockerignore",

    // The prose. CLAUDE.md sits here rather than beside the configs because it is a
    // document about how to work in the repository, not a tool's input.
    "README.md": "CONTRIBUTING.md, SECURITY.md, CLAUDE.md",

    // Repository hygiene: what git tracks, how it normalises it, and what must never
    // enter it.
    ".gitignore": ".gitattributes, .editorconfig, .gitleaks.toml, .env, .env.*",

    // The per-package pattern, which is where most of the file count actually lives.
    "tsconfig.json": "tsconfig.*.json, *.tsbuildinfo",
    "*.ts": "$(capture).test.ts, $(capture).spec.ts, $(capture).d.ts, $(capture).js",
    "*.tsx": "$(capture).test.tsx, $(capture).spec.tsx, $(capture).module.css"
  },

  // Sort folders first, then files, so the eight real directories are the first thing
  // the tree shows.
  "explorer.sortOrder": "type",

  // --- Consistency with what the build enforces -------------------------------------
  // `.editorconfig` is authoritative; these make the editor agree with it before a file
  // is saved rather than after CI complains. UTF-8 WITHOUT a BOM is load-bearing on
  // Windows: a BOM in a package.json makes every import in that package unresolvable.
  "files.encoding": "utf8",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "editor.rulers": [100],
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": [{ "mode": "auto" }],

  // Markdown keeps its trailing spaces — two of them are a hard line break, and the
  // documents in docs/ use them.
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  }
}

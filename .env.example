# =====================================================================================
# StarLink configuration template (ADR-017, doc §35).
#
# One prefix, SL_, and NO fallback chain to any other product's variables. A fallback
# — "read SL_MONGO_URL, and if absent try something else" — is precisely how a
# standalone system acquires a dependency nobody declared (doc §35.1).
#
# Copy to .env for local development. Production supplies these through the platform's
# secret store and REFUSES TO START on a shipped development default, a secret below
# minimum length, or a database outside the starlink namespace: a misconfigured
# production system that starts is worse than one that refuses.
# =====================================================================================

SL_ENV=dev
SL_LOG_LEVEL=info

# --- datastores -----------------------------------------------------------------
# Local (binaries or compose):
SL_DATABASE_URL=postgres://starlink:starlink_dev_only@localhost:5432/starlink
#
# Neon (team's chosen dev provider). TWO things to get right:
#
#   1. The database must be named `starlink` (or `starlink_<suffix>`). Neon's default
#      is `neondb`, which the §35.4 namespace guard REFUSES by design — that guard is
#      what makes "it cannot reach another product's data" a property rather than a
#      promise, so create a `starlink` database rather than relaxing it.
#   2. Use the DIRECT endpoint, not the pooled one (`-pooler` in the host). The pooled
#      endpoint is PgBouncer in transaction mode, which breaks session-level advisory
#      locks and LISTEN/NOTIFY — both of which the Phase 3 outbox relay depends on.
#
# SL_DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/starlink?sslmode=require
#
# TLS is inferred from the host: any non-loopback host gets a verified TLS connection
# whether or not sslmode appears in the URL.

SL_REDIS_URL=redis://localhost:6379

# --- secrets (no production defaults, deliberately) -------------------------------
# Distinct keys per purpose, so one compromise is not both (doc §27.14).
SL_SESSION_SECRET=dev-only-session-secret-change-me-32chars
SL_CURSOR_SECRET=dev-only-cursor-secret-change-me-32chars

# --- surfaces ---------------------------------------------------------------------
SL_API_PORT=3000
SL_REALTIME_PORT=3100
SL_WORKERS_PORT=3200
SL_WEB_EMPLOYEE_ORIGIN=http://localhost:3010
SL_WEB_CUSTOMER_ORIGIN=http://localhost:3020

# --- object storage ---------------------------------------------------------------
SL_STORAGE_DRIVER=minio
SL_STORAGE_ENDPOINT=http://localhost:9000
SL_STORAGE_BUCKET=starlink-attachments
SL_STORAGE_KEY=starlink
SL_STORAGE_SECRET=starlink_dev_only
SL_STORAGE_MAX_BYTES=26214400

# --- adapter selection ------------------------------------------------------------
# Replacing an adapter is a configuration change, never a code change outside
# adapters/ (INTEGRATION_CONTRACTS §1 rule 2).
# These values are the ones the product is developed and tested against. A template that
# differs from the tested configuration is not documentation, it is a second configuration
# nobody runs — which is how SL_ADAPTER_WORK_ORCHESTRATOR=mock came to mean "every customer
# conversation is accepted and then dropped into an in-memory Map", with the routing sweep
# reporting success throughout. Keep this block equal to the defaults in apps/api/config.ts.
SL_ADAPTER_IAM=local
SL_ADAPTER_EMPLOYEE_DIRECTORY=mock
SL_ADAPTER_CUSTOMER_IDENTITY=mock
SL_ADAPTER_CUSTOMER_CONTEXT=mock
# `local` is the PostgreSQL-backed allocator. `mock` is in-memory and loses work; it exists
# for unit tests that never open a database, and is not a configuration to run a process on.
SL_ADAPTER_WORK_ORCHESTRATOR=local
SL_ADAPTER_CONSENT=mock
SL_ADAPTER_OBJECT_STORAGE=local
SL_ADAPTER_EVENT_BUS=mock
SL_ADAPTER_SEARCH=mock
# `disabled` and `remote` are the only values. N-05 (provider choice and the DPA) is
# unanswered, so `disabled` is both the default and the only one that can be honoured —
# this line said `mock`, which is not in the enum, so a copied template refused to start.
SL_ADAPTER_AI=disabled

# --- realtime ---------------------------------------------------------------------
# Exists so NFR-AVL-2 is testable rather than asserted: the application must remain
# fully usable with realtime switched off.
SL_REALTIME_ENABLED=true
SL_RT_MAX_CONN_PER_PRINCIPAL=8

# --- retention ---------------------------------------------------------------------
# Audit request context ages out on its own schedule while the ledger stays intact
# (doc §31.4). Final value pending D-06 (Legal).
SL_AUDIT_CONTEXT_TTL_DAYS=180
